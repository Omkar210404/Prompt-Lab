# Copy to .env and edit. Never commit .env.
#
# prompt-lab reads API keys only from environment variables. An experiment file names
# the variable to use for each model (api_key_env: GROQ_API_KEY), never the key itself.
# The mock provider needs no key, so the demo and the tests run without this file.

# Groq (https://console.groq.com/keys), base_url: https://api.groq.com/openai/v1
GROQ_API_KEY=

# OpenAI, base_url: https://api.openai.com/v1
OPENAI_API_KEY=

# OpenRouter, base_url: https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
